<div class="max-w-xl mx-auto pb-[env(safe-area-inset-bottom)]">
  <div class="flex items-center gap-3 mb-5">
    <%= link_to :back, class: "sm:hidden p-1.5 -ml-1.5 rounded-lg text-gray-500 hover:bg-gray-100 transition-colors" do %>
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
    <% end %>
    <h2 class="text-xl font-semibold text-gray-900">New Task</h2>
  </div>
  <div class="bg-white rounded-2xl border border-gray-200/60 shadow-sm p-4 sm:p-6">
    <%= render "form", task: @task %>
  </div>
</div>
