<% field = "mt-1.5 block w-full rounded-xl border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-base py-2.5 px-3" %>
<% label = "block text-sm font-medium text-gray-600" %>

<%= form_with model: task, class: "space-y-5" do |f| %>
  <% if task.errors.any? %>
    <div class="bg-red-50 text-red-700 p-3 rounded-xl text-sm space-y-0.5">
      <% task.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <label class="<%= label %>">Title</label>
    <%= f.text_field :title, class: field, autofocus: true, placeholder: "What needs doing?" %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <label class="<%= label %>">Channel</label>
      <%= f.collection_select :channel_id, @channels, :id, :name, { include_blank: "None" }, class: field %>
    </div>
    <div>
      <label class="<%= label %>">Weekly objective</label>
      <%= f.collection_select :weekly_objective_id,
          current_user.weekly_objectives.for_week(Date.current).active.ordered,
          :id, :title, { include_blank: "None" }, class: field %>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <label class="<%= label %>">Scheduled date</label>
      <%= f.date_field :scheduled_date, class: field %>
    </div>
    <div>
      <label class="<%= label %>">Planned time (min)</label>
      <%= f.number_field :planned_minutes, class: field, min: 0, step: 5, inputmode: "numeric" %>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <label class="<%= label %>">Priority</label>
      <%= f.select :priority, [["None", 0], ["Low", 1], ["Medium", 2], ["High", 3]], {}, class: field %>
    </div>
    <div>
      <label class="<%= label %>">Due date</label>
      <%= f.date_field :due_date, class: field %>
    </div>
  </div>

  <div>
    <label class="<%= label %> mb-1.5">Notes</label>
    <%= f.rich_text_area :notes, class: "min-h-[120px]" %>
  </div>

  <div class="flex flex-col-reverse sm:flex-row gap-2 pt-1">
    <%= link_to "Cancel", :back, class: "px-4 py-3 sm:py-2.5 text-center text-sm font-medium text-gray-600 hover:text-gray-900 rounded-xl hover:bg-gray-100 transition-colors" %>
    <%= f.submit "Save task", class: "flex-1 sm:flex-none px-5 py-3 sm:py-2.5 bg-indigo-600 text-white text-sm font-semibold rounded-xl hover:bg-indigo-700 shadow-sm shadow-indigo-200 cursor-pointer transition-colors" %>
  </div>
<% end %>
